edition 5;
module ts;

import std.buffer;
import std.bytes;
import std.list;
import std.option;

import model;

// The TypeScript target (#5): the model, as one deterministic .ts file.
//
// * an `interface` per `components.schemas` entry -- a class per component,
//   which is what `$ref` resolution was for;
// * a typed function per operation: required path parameters as required
//   arguments, the body typed by its schema, the responses a typed union;
// * `application/problem+json` as a typed error the caller must handle:
//   `ProblemError`, carrying the Problem component's fields and the 422's
//   `errors` array with `pointer`/`code`/`detail`;
// * no coercion: a response is the interface it declares, or the error.
//
// The writer takes the model by value and consumes it as it prints: every
// schema it prints, it ends. Same document, same bytes -- the output is a
// pure function of the model, and the model of the document.

// ---------------------------------------------------------------------
// Types
// ---------------------------------------------------------------------

// The TypeScript type for a schema. Consumes the schema it prints.
fn ts_type[&h](heap: &!h Heap, out: buffer.Buffer, s: model.Schema) -> [heap] buffer.Buffer {
    var line = out;
    match s {
        model.Schema::Ref(name) => {
            borrow name as &nb in {
                line = buffer.append(heap, line, buffer.bytes(nb));
            }
            buffer.drop(heap, name);
        }
        model.Schema::Boolean => {
            line = buffer.append(heap, line, "boolean");
        }
        model.Schema::Integer => {
            line = buffer.append(heap, line, "number");
        }
        model.Schema::Number => {
            line = buffer.append(heap, line, "number");
        }
        model.Schema::String => {
            line = buffer.append(heap, line, "string");
        }
        model.Schema::Array(inner) => {
            let items = unbox(heap, inner);
            line = buffer.append(heap, line, "Array<");
            line = ts_type(heap, line, items);
            line = buffer.append(heap, line, ">");
        }
        model.Schema::Object(held) => {
            // An inline object -- until cancho-web#16 lands these arrive
            // unnamed; the type is written structurally, as the model kept it.
            let fields = unbox(heap, held);
            line = buffer.append(heap, line, "{ ");
            line = fields_type(heap, line, fields);
            line = buffer.append(heap, line, " }");
        }
    }
    return line;
}

// `name: type;` per field, `name?: type;` when not required. Consumes the list.
fn fields_type[&h](heap: &!h Heap, out: buffer.Buffer, fields: list.List[model.Field]) -> [heap] buffer.Buffer {
    match fields {
        list.List::Empty => {
            return out;
        }
        list.List::Cons(one, rest) => {
            let model.Field { name, schema, required } = one;
            let tail = unbox(heap, rest);
            var line = out;
            borrow name as &nb in {
                line = buffer.append(heap, line, buffer.bytes(nb));
            }
            if !required {
                line = buffer.append(heap, line, "?");
            }
            line = buffer.append(heap, line, ": ");
            line = ts_type(heap, line, schema);
            line = buffer.append(heap, line, "; ");
            buffer.drop(heap, name);
            return fields_type(heap, line, tail);
        }
    }
}

// ---------------------------------------------------------------------
// The file
// ---------------------------------------------------------------------

// The whole client. Consumes the model: it ends every list it walks.
pub fn write[&h](heap: &!h Heap, doc: model.Doc) -> [heap] buffer.Buffer {
    let model.Doc { operations, components } = doc;
    var out = buffer.empty(heap, 8192);
    out = buffer.append(heap, out, "// Generated by clientgen from the byte-verified OpenAPI 3.1 document.\n");
    out = buffer.append(heap, out, "// Do not edit: regenerate (the gate, issue #6, diffs this file in CI).\n");
    out = buffer.append(heap, out, "// Strict types, no coercion: a response is the interface it declares,\n");
    out = buffer.append(heap, out, "// or a ProblemError the caller must handle.\n\n");
    let (components, has_problem) = has_problem_component(heap, components);
    if !has_problem {
        out = problem_type(heap, out);
    } else {
        // The document names its own error schema `Problem` (cancho-web's
        // does): the generated interfaces below include it, and ProblemError
        // needs only the class.
        out = buffer.append(heap, out, "export class ProblemError extends Error { constructor(public problem: Problem) { super(problem.title); } }\n\n");
    }
    out = components_block(heap, out, components);
    out = operations_block(heap, out, operations);
    out = runtime(heap, out);
    return out;
}

// `application/problem+json` as a typed error (RFC 9457): the document's
// Problem component, written as the exception the caller catches.
fn problem_type[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var line = out;
    line = buffer.append(heap, line, "export interface ProblemDetail { pointer: string; code: string; detail: string; }\n");
    line = buffer.append(heap, line, "export interface Problem { type: string; title: string; status: number; detail?: string; count?: number; errors?: ProblemDetail[]; }\n");
    line = buffer.append(heap, line, "export class ProblemError extends Error { constructor(public problem: Problem) { super(problem.title); } }\n\n");
    return line;
}

// Does the document name a component `Problem`? (cancho-web's does; the
// generated client then uses it rather than emitting a second one.)
// Takes the list and hands it back: the reading is a pass, not an end.
fn has_problem_component[&h](heap: &!h Heap, comps: list.List[model.Component]) -> [heap] (list.List[model.Component], bool) {
    match comps {
        list.List::Empty => {
            return (list.List::Empty, false);
        }
        list.List::Cons(one, rest) => {
            let tail = unbox(heap, rest);
            let (kept, found_tail) = has_problem_component(heap, tail);
            let model.Component { name, schema } = one;
            var found = found_tail;
            borrow name as &nb in {
                if bytes.equal(buffer.bytes(nb), "Problem") {
                    found = true;
                }
            }
            let rebuilt = list.push(heap, kept, model.Component { name: name, schema: schema });
            return (rebuilt, found);
        }
    }
}

fn components_block[&h](heap: &!h Heap, out: buffer.Buffer, comps: list.List[model.Component]) -> [heap] buffer.Buffer {
    match comps {
        list.List::Empty => {
            return out;
        }
        list.List::Cons(one, rest) => {
            let model.Component { name, schema } = one;
            let tail = unbox(heap, rest);
            var line = buffer.append(heap, out, "export interface ");
            borrow name as &nb in {
                line = buffer.append(heap, line, buffer.bytes(nb));
            }
            line = buffer.append(heap, line, " ");
            line = schema_interface(heap, line, schema);
            line = buffer.append(heap, line, "\n\n");
            buffer.drop(heap, name);
            return components_block(heap, line, tail);
        }
    }
}

// One component's shape: `{ ... }` for an object, `= type` otherwise.
fn schema_interface[&h](heap: &!h Heap, out: buffer.Buffer, s: model.Schema) -> [heap] buffer.Buffer {
    var line = out;
    match s {
        model.Schema::Object(held) => {
            let fields = unbox(heap, held);
            line = buffer.append(heap, line, "{\n");
            line = interface_fields(heap, line, fields);
            line = buffer.append(heap, line, "}\n");
        }
        model.Schema::Ref(name) => {
            line = buffer.append(heap, line, "= ");
            borrow name as &nb in {
                line = buffer.append(heap, line, buffer.bytes(nb));
            }
            buffer.drop(heap, name);
            line = buffer.append(heap, line, ";\n");
        }
        model.Schema::Boolean => {
            line = buffer.append(heap, line, "= boolean;\n");
        }
        model.Schema::Integer => {
            line = buffer.append(heap, line, "= number;\n");
        }
        model.Schema::Number => {
            line = buffer.append(heap, line, "= number;\n");
        }
        model.Schema::String => {
            line = buffer.append(heap, line, "= string;\n");
        }
        model.Schema::Array(inner) => {
            let items = unbox(heap, inner);
            line = buffer.append(heap, line, "= Array<");
            line = ts_type(heap, line, items);
            line = buffer.append(heap, line, ">;\n");
        }
    }
    return line;
}

// The fields of an interface, one per line, `name?: type` for optional.
fn interface_fields[&h](heap: &!h Heap, out: buffer.Buffer, fields: list.List[model.Field]) -> [heap] buffer.Buffer {
    match fields {
        list.List::Empty => {
            return out;
        }
        list.List::Cons(one, rest) => {
            let model.Field { name, schema, required } = one;
            let tail = unbox(heap, rest);
            var line = buffer.append(heap, out, "  ");
            borrow name as &nb in {
                line = buffer.append(heap, line, buffer.bytes(nb));
            }
            if !required {
                line = buffer.append(heap, line, "?");
            }
            line = buffer.append(heap, line, ": ");
            line = ts_type(heap, line, schema);
            line = buffer.append(heap, line, ";\n");
            buffer.drop(heap, name);
            return interface_fields(heap, line, tail);
        }
    }
}

// ---------------------------------------------------------------------
// The operations
// ---------------------------------------------------------------------

fn operations_block[&h](heap: &!h Heap, out: buffer.Buffer, ops: list.List[model.Operation]) -> [heap] buffer.Buffer {
    match ops {
        list.List::Empty => {
            return out;
        }
        list.List::Cons(one, rest) => {
            let tail = unbox(heap, rest);
            var line = operation_block(heap, out, one);
            return operations_block(heap, line, tail);
        }
    }
}

// One operation: a typed function. Required path parameters are required
// arguments (strictness is the point), the body is typed by its schema, the
// return is the typed union of the successful responses.
fn operation_block[&h](heap: &!h Heap, out: buffer.Buffer, op: model.Operation) -> [heap] buffer.Buffer {
    let model.Operation { id, method, path, parameters, body, body_optional, responses } = op;
    var line = buffer.append(heap, out, "export async function ");
    borrow id as &ib in {
        line = buffer.append(heap, line, buffer.bytes(ib));
    }
    line = buffer.append(heap, line, "(");
    // The parameters, in one consuming pass: required path arguments and
    // the query names (a path parameter is interpolated; a header parameter
    // is an argument of the request, which this slice does not model yet).
    let args = buffer.empty(heap, 128);
    let qnames = buffer.empty(heap, 64);
    let opttypes = buffer.empty(heap, 64);
    let (args_text, query_text, opts_text, required_count) = args_and_query(heap, parameters, args, qnames, opttypes, 0);
    borrow args_text as &ab in {
        let text = buffer.bytes(ab);
        var end = len(text);
        while end > 0 && (int_of(text[end - 1]) == 32 || int_of(text[end - 1]) == 44) {
            end = end - 1;
        }
        line = buffer.append(heap, line, text[0..end]);
    }
    buffer.drop(heap, args_text);
    var has_body = false;
    borrow body as &bd in {
        if option.is_some(bd) {
            has_body = true;
            if required_count > 0 {
                line = buffer.append(heap, line, ", ");
            }
            line = buffer.append(heap, line, "body: ");
        }
    }
    line = body_type(heap, line, body);
    // The optional query parameters, as one optional options argument.
    borrow opts_text as &ob in {
        let otext = buffer.bytes(ob);
        var oend = len(otext);
        while oend > 0 && (int_of(otext[oend - 1]) == 32 || int_of(otext[oend - 1]) == 44) {
            oend = oend - 1;
        }
        if oend > 0 {
            if required_count > 0 || has_body {
                line = buffer.append(heap, line, ", ");
            }
            line = buffer.append(heap, line, "options?: { ");
            line = buffer.append(heap, line, otext[0..oend]);
            line = buffer.append(heap, line, " }");
        }
    }
    buffer.drop(heap, opts_text);
    line = buffer.append(heap, line, "): Promise<");
    line = return_type(heap, line, responses);
    line = buffer.append(heap, line, "> {\n");
    // The implementation: the path template, the query, the call.
    line = buffer.append(heap, line, "  return request(\"");
    line = buffer.append(heap, line, model.method_name(method));
    line = buffer.append(heap, line, "\", ");
    line = path_expression(heap, line, path);
    line = buffer.append(heap, line, ", ");
    borrow query_text as &qb in {
        let qtext = buffer.bytes(qb);
        var qend = len(qtext);
        while qend > 0 && (int_of(qtext[qend - 1]) == 32 || int_of(qtext[qend - 1]) == 44) {
            qend = qend - 1;
        }
        if qend == 0 {
            line = buffer.append(heap, line, "undefined");
        } else {
            line = buffer.append(heap, line, "options");
        }
    }
    buffer.drop(heap, query_text);
    if has_body {
        line = buffer.append(heap, line, ", body");
    } else {
        line = buffer.append(heap, line, ", undefined");
    }
    line = buffer.append(heap, line, ");\n");
    line = buffer.append(heap, line, "}\n\n");
    // The pieces were printed (the parameters by the one pass, the body by
    // `body_type`, the responses by `return_type`); what is left, ends here.
    buffer.drop(heap, id);
    return line;
}

// The body's type (`?` when the body may be left out is not an argument
// optionality: an optional body is `body: T | undefined`).
fn body_type[&h](heap: &!h Heap, out: buffer.Buffer, body: option.Option[model.Schema]) -> [heap] buffer.Buffer {
    match body {
        option.Option::None => {
            return out;
        }
        option.Option::Some(schema) => {
            return ts_type(heap, out, schema);
        }
    }
}

// `name: type,` per required path parameter. Also answers how many there
// were, so the caller can place its commas (cancho has no closures; the
// count comes back through a helper).
// One consuming pass over the parameters: the required path arguments' text,
// the optional query names' text, and how many required path parameters there
// are (cancho has no closures, so the three travel together).
fn args_and_query[&h](heap: &!h Heap, ps: list.List[model.Parameter], args: buffer.Buffer, query: buffer.Buffer, opts: buffer.Buffer, count: int) -> [heap] (buffer.Buffer, buffer.Buffer, buffer.Buffer, int) {
    match ps {
        list.List::Empty => {
            return (args, query, opts, count);
        }
        list.List::Cons(one, rest) => {
            let tail = unbox(heap, rest);
            let model.Parameter { name, place, required, schema } = one;
            var in_path = false;
            var in_query = false;
            match place {
                model.Where::InPath => {
                    in_path = true;
                }
                model.Where::InQuery => {
                    in_query = true;
                }
                model.Where::InHeader => {
                }
            }
            var args2 = args;
            var query2 = query;
            var opts2 = opts;
            var n = count;
            if required && in_path {
                borrow name as &nb in {
                    args2 = buffer.append(heap, args2, buffer.bytes(nb));
                }
                args2 = buffer.append(heap, args2, ": ");
                args2 = ts_type(heap, args2, schema);
                args2 = buffer.append(heap, args2, ", ");
                n = n + 1;
            } else if in_query && !required {
                // An optional query parameter: an optional field of the
                // options argument, both here (the type) and in the query
                // object (the value).
                borrow name as &nb in {
                    opts2 = buffer.append(heap, opts2, buffer.bytes(nb));
                    query2 = buffer.append(heap, query2, buffer.bytes(nb));
                }
                opts2 = buffer.append(heap, opts2, "?: ");
                opts2 = ts_type(heap, opts2, schema);
                opts2 = buffer.append(heap, opts2, ", ");
                query2 = buffer.append(heap, query2, ", ");
            } else {
                model.drop_schema(heap, schema);
            }
            buffer.drop(heap, name);
            return args_and_query(heap, tail, args2, query2, opts2, n);
        }
    }
}

// The typed union of the successful responses' bodies (2xx); the error
// responses are thrown as ProblemError, never in the union. Consumes the
// list; the first type has no separator, the rest ` | `.
fn return_type[&h](heap: &!h Heap, out: buffer.Buffer, rs: list.List[model.Response]) -> [heap] buffer.Buffer {
    return return_arms(heap, out, rs, false);
}

fn return_arms[&h](heap: &!h Heap, out: buffer.Buffer, rs: list.List[model.Response], seen: bool) -> [heap] buffer.Buffer {
    match rs {
        list.List::Empty => {
            if seen {
                return out;
            }
            return buffer.append(heap, out, "void");
        }
        list.List::Cons(one, rest) => {
            let tail = unbox(heap, rest);
            let model.Response { status, body } = one;
            var line = out;
            var seen2 = seen;
            match body {
                option.Option::None => {
                }
                option.Option::Some(schema) => {
                    // Only the successful responses are the union; an error
                    // response (4xx, 5xx) is ProblemError, thrown.
                    if status >= 200 && status < 300 {
                        if seen2 {
                            line = buffer.append(heap, line, " | ");
                        }
                        line = ts_type(heap, line, schema);
                        seen2 = true;
                    } else {
                        model.drop_schema(heap, schema);
                    }
                }
            }
            return return_arms(heap, line, tail, seen2);
        }
    }
}

// The path, `{id}` templates become `${id}` interpolations.
fn path_expression[&h](heap: &!h Heap, out: buffer.Buffer, path: buffer.Buffer) -> [heap] buffer.Buffer {
    var line = buffer.append(heap, out, "`");
    borrow path as &pb in {
        let text = buffer.bytes(pb);
        var i = 0;
        while i < len(text) {
            if int_of(text[i]) == 123 && i + 1 < len(text) {
                var end = i + 1;
                while end < len(text) && int_of(text[end]) != 125 {
                    end = end + 1;
                }
                line = buffer.append(heap, line, "${");
                line = buffer.append(heap, line, text[i + 1..end]);
                line = buffer.append(heap, line, "}");
                i = end + 1;
            } else {
                line = buffer.push(heap, line, text[i]);
                i = i + 1;
            }
        }
    }
    line = buffer.append(heap, line, "`");
    buffer.drop(heap, path);
    return line;
}

// ---------------------------------------------------------------------
// The runtime
// ---------------------------------------------------------------------

// The fetch: no coercion. `problem+json` is ProblemError; the body is the
// interface because the document says the response is that schema.
fn runtime[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var line = out;
    line = buffer.append(heap, line, "const base = \"\";\n\n");
    line = buffer.append(heap, line, "async function request<T>(method: string, path: string, query: Record<string, unknown> | undefined, body: unknown): Promise<T> {\n");
    line = buffer.append(heap, line, "  const url = new URL(base + path, globalThis.location.href);\n");
    line = buffer.append(heap, line, "  if (query) for (const [k, v] of Object.entries(query)) if (v !== undefined) url.searchParams.set(k, String(v));\n");
    line = buffer.append(heap, line, "  const res = await fetch(url, { method, headers: body === undefined ? undefined : { \"Content-Type\": \"application/json\" }, body: body === undefined ? undefined : JSON.stringify(body) });\n");
    line = buffer.append(heap, line, "  const type = res.headers.get(\"Content-Type\") ?? \"\";\n");
    line = buffer.append(heap, line, "  if (type.startsWith(\"application/problem+json\")) { throw new ProblemError(await res.json()); }\n");
    line = buffer.append(heap, line, "  if (!res.ok) { throw new ProblemError({ type: \"about:blank\", title: res.statusText, status: res.status }); }\n");
    line = buffer.append(heap, line, "  if (res.status === 204) { return undefined as T; }\n");
    line = buffer.append(heap, line, "  return await res.json() as T;\n");
    line = buffer.append(heap, line, "}\n");
    return line;
}
