edition 5;
module py;

import std.buffer;
import std.bytes;
import std.list;
import std.option;

import model;

// The Python target (#8): the model, as one deterministic .py file.
//
// * a frozen `@dataclass` per component -- a class per named shape, the same
//   discipline as the other two writers;
// * a typed method per operation on a `Client` class: required path
//   parameters positional, optional query parameters keyword arguments
//   (Python has no struct literal to pass; the function is the interface);
// * `problem+json` a typed exception (`ProblemError`), carrying the
//   Problem component's fields and the 422's `errors`;
// * the runtime over `urllib.request` only: no `pip install`, no
//   third-party dependency -- a generated client that needs one has failed
//   the point.
//
// The generated file uses single-quoted Python strings throughout, so no
// emitted text needs an escaped quote; `docs/design.md` section 8 has the
// decisions.
//
// Same model, same gate, same bytes per document. The writer consumes the
// model as it prints, exactly as `ts.cho` and `gow.cho` do.

// The Python type for a schema. Consumes the schema it prints.
fn py_type[&h](heap: &!h Heap, out: buffer.Buffer, s: model.Schema) -> [heap] buffer.Buffer {
    var line = out;
    match s {
        model.Schema::Ref(name) => {
            borrow name as &nb in {
                line = buffer.append(heap, line, buffer.bytes(nb));
            }
            buffer.drop(heap, name);
        }
        model.Schema::Boolean => {
            line = buffer.append(heap, line, "bool");
        }
        model.Schema::Integer => {
            line = buffer.append(heap, line, "int");
        }
        model.Schema::Number => {
            line = buffer.append(heap, line, "float");
        }
        model.Schema::String => {
            line = buffer.append(heap, line, "str");
        }
        model.Schema::Array(inner) => {
            let items = unbox(heap, inner);
            line = buffer.append(heap, line, "list[");
            line = py_type(heap, line, items);
            line = buffer.append(heap, line, "]");
        }
        model.Schema::Object(held) => {
            // An inline object (until cancho-web#16 names these): the
            // honest spelling is a dict shape, as the model kept it.
            let fields = unbox(heap, held);
            model.drop_fields(heap, fields);
            line = buffer.append(heap, line, "dict[str, Any]");
        }
    }
    return line;
}

// The whole file. Consumes the model.
pub fn write[&h](heap: &!h Heap, doc: model.Doc) -> [heap] buffer.Buffer {
    let model.Doc { operations, components } = doc;
    var out = buffer.empty(heap, 8192);
    out = buffer.append(heap, out, "# Generated by clientgen from the byte-verified OpenAPI 3.1 document. DO NOT EDIT.\n");
    out = buffer.append(heap, out, "# The gate (issue #6) diffs this file in CI. Strict types, no coercion:\n");
    out = buffer.append(heap, out, "# a response is the dataclass it declares, or a ProblemError.\n\n");
    out = buffer.append(heap, out, "from __future__ import annotations\n\n");
    out = buffer.append(heap, out, "import json\nimport urllib.error\nimport urllib.parse\nimport urllib.request\nfrom dataclasses import dataclass, is_dataclass\nfrom typing import Any, cast\n\n");
    out = problem_detail_type(heap, out);
    let (components, has_problem) = has_problem_component(heap, components);
    if !has_problem {
        out = problem_type(heap, out);
    } else {
        // The document names its own error schema `Problem`: the dataclasses
        // below include it, and only the exception wrapper is the tool's.
        out = buffer.append(heap, out, "class ProblemError(Exception):\n    # The typed error the caller must handle: application/problem+json.\n    # The problem is on .problem; the 422 errors each have pointer/code/detail.\n\n    def __init__(self, problem: Problem) -> None:\n        self.problem = problem\n        super().__init__(problem.title)\n\n    def __str__(self) -> str:\n        return f'{self.problem.title} ({self.problem.status})'\n\n");
    }
    out = components_block(heap, out, components);
    out = client_block(heap, out, operations);
    out = runtime(heap, out);
    return out;
}

// `problem+json` as a typed exception (RFC 9457): the Problem the document
// declares (its own component, when it names one), the 422's `errors` with
// `pointer`/`code`/`detail`.
// ProblemDetail: always emitted -- the 422's `errors` items, the typed way.
fn problem_detail_type[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    return buffer.append(heap, out, "@dataclass(frozen=True)\nclass ProblemDetail:\n    pointer: str\n    code: str\n    detail: str\n\n");
}

fn problem_type[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var line = out;
    line = buffer.append(heap, line, "@dataclass(frozen=True)\nclass Problem:\n    type: str\n    title: str\n    status: int\n    detail: str | None = None\n    count: int | None = None\n    errors: list[ProblemDetail] | None = None\n\n");
    line = buffer.append(heap, line, "class ProblemError(Exception):\n    # The typed error the caller must handle: application/problem+json.\n    # The problem is on .problem; the 422 errors each have pointer/code/detail.\n\n    def __init__(self, problem: Problem) -> None:\n        self.problem = problem\n        super().__init__(problem.title)\n\n    def __str__(self) -> str:\n        return f'{self.problem.title} ({self.problem.status})'\n\n");
    return line;
}

// Does the document name a component `Problem`? (cancho-web's does; the
// generated client then uses it rather than emitting a second one.)
// Takes the list and hands it back: the reading is a pass, not an end.
fn has_problem_component[&h](heap: &!h Heap, comps: list.List[model.Component]) -> [heap] (list.List[model.Component], bool) {
    match comps {
        list.List::Empty => {
            return (list.List::Empty, false);
        }
        list.List::Cons(one, rest) => {
            let tail = unbox(heap, rest);
            let (kept, found_tail) = has_problem_component(heap, tail);
            let model.Component { name, schema } = one;
            var found = found_tail;
            borrow name as &nb in {
                if bytes.equal(buffer.bytes(nb), "Problem") {
                    found = true;
                }
            }
            let rebuilt = list.push(heap, kept, model.Component { name: name, schema: schema });
            return (rebuilt, found);
        }
    }
}

fn components_block[&h](heap: &!h Heap, out: buffer.Buffer, comps: list.List[model.Component]) -> [heap] buffer.Buffer {
    match comps {
        list.List::Empty => {
            return out;
        }
        list.List::Cons(one, rest) => {
            let model.Component { name, schema } = one;
            let tail = unbox(heap, rest);
            var line = buffer.append(heap, out, "@dataclass(frozen=True)\nclass ");
            borrow name as &nb in {
                line = buffer.append(heap, line, buffer.bytes(nb));
            }
            line = buffer.append(heap, line, ":\n");
            line = class_fields(heap, line, schema);
            line = buffer.append(heap, line, "\n");
            buffer.drop(heap, name);
            return components_block(heap, line, tail);
        }
    }
}

// The fields of a dataclass. Optionality is the default: a required field has
// none, an optional one is `T | None = None` -- the same strictness the Go
// pointer and the TS `?` give, so a required field is distinguishable from an
// absent one.
fn class_fields[&h](heap: &!h Heap, out: buffer.Buffer, s: model.Schema) -> [heap] buffer.Buffer {
    match s {
        model.Schema::Object(held) => {
            let fields = unbox(heap, held);
            return class_fields_walk(heap, out, fields);
        }
        model.Schema::Ref(name) => {
            var line = buffer.append(heap, out, "    value: ");
            borrow name as &nb in {
                line = buffer.append(heap, line, buffer.bytes(nb));
            }
            buffer.drop(heap, name);
            line = buffer.append(heap, line, "\n");
            return line;
        }
        model.Schema::Boolean => {
            return buffer.append(heap, out, "    value: bool\n");
        }
        model.Schema::Integer => {
            return buffer.append(heap, out, "    value: int\n");
        }
        model.Schema::Number => {
            return buffer.append(heap, out, "    value: float\n");
        }
        model.Schema::String => {
            return buffer.append(heap, out, "    value: str\n");
        }
        model.Schema::Array(inner) => {
            let items = unbox(heap, inner);
            var line = buffer.append(heap, out, "    value: list[");
            line = py_type(heap, line, items);
            line = buffer.append(heap, line, "]\n");
            return line;
        }
    }
}

fn class_fields_walk[&h](heap: &!h Heap, out: buffer.Buffer, fields: list.List[model.Field]) -> [heap] buffer.Buffer {
    match fields {
        list.List::Empty => {
            return out;
        }
        list.List::Cons(one, rest) => {
            let model.Field { name, schema, required } = one;
            let tail = unbox(heap, rest);
            var line = buffer.append(heap, out, "    ");
            borrow name as &nb in {
                line = buffer.append(heap, line, buffer.bytes(nb));
            }
            line = buffer.append(heap, line, ": ");
            line = py_type(heap, line, schema);
            if !required {
                line = buffer.append(heap, line, " | None = None");
            }
            line = buffer.append(heap, line, "\n");
            buffer.drop(heap, name);
            return class_fields_walk(heap, line, tail);
        }
    }
}

// ---------------------------------------------------------------------
// The client
// ---------------------------------------------------------------------

// The Client class: a typed method per operation. Optional query
// parameters are keyword arguments -- the function is the interface.
fn client_block[&h](heap: &!h Heap, out: buffer.Buffer, ops: list.List[model.Operation]) -> [heap] buffer.Buffer {
    var line = buffer.append(heap, out, "class Client:\n    def __init__(self, base_url: str) -> None:\n        self.base_url = base_url\n\n");
    return methods_block(heap, line, ops);
}

fn methods_block[&h](heap: &!h Heap, out: buffer.Buffer, ops: list.List[model.Operation]) -> [heap] buffer.Buffer {
    match ops {
        list.List::Empty => {
            return out;
        }
        list.List::Cons(one, rest) => {
            let tail = unbox(heap, rest);
            var line = method_block(heap, out, one);
            return methods_block(heap, line, tail);
        }
    }
}

// One operation: a typed method. Required path parameters are positional;
// the optional query parameters and the body are keyword-only.
fn method_block[&h](heap: &!h Heap, out: buffer.Buffer, op: model.Operation) -> [heap] buffer.Buffer {
    let model.Operation { id, method, path, parameters, body, body_optional, responses } = op;
    var line = buffer.append(heap, out, "    def ");
    borrow id as &ib in {
        line = buffer.append(heap, line, buffer.bytes(ib));
    }
    line = buffer.append(heap, line, "(self");
    // The parameters, in one consuming pass.
    let args = buffer.empty(heap, 128);
    let qnames = buffer.empty(heap, 64);
    let opttypes = buffer.empty(heap, 64);
    let (args_text, query_text, opts_text, required_count) = args_and_query(heap, parameters, args, qnames, opttypes, 0);
    borrow args_text as &ab in {
        let text = buffer.bytes(ab);
        var end = len(text);
        while end > 0 && (int_of(text[end - 1]) == 32 || int_of(text[end - 1]) == 44) {
            end = end - 1;
        }
        line = buffer.append(heap, line, text[0..end]);
    }
    buffer.drop(heap, args_text);
    var has_body = false;
    borrow body as &bd in {
        if option.is_some(bd) {
            has_body = true;
        }
    }
    // The keyword-only part: the query options, then the body.
    var has_opts = false;
    borrow opts_text as &ob in {
        let otext = buffer.bytes(ob);
        var oend = len(otext);
        while oend > 0 && (int_of(otext[oend - 1]) == 32 || int_of(otext[oend - 1]) == 44) {
            oend = oend - 1;
        }
        if oend > 0 {
            has_opts = true;
        }
    }
    if has_opts {
        line = buffer.append(heap, line, ", *, ");
    } else if has_body {
        line = buffer.append(heap, line, ", *");
    }
    if has_opts {
        borrow opts_text as &ob in {
            let otext = buffer.bytes(ob);
            var oend = len(otext);
            while oend > 0 && (int_of(otext[oend - 1]) == 32 || int_of(otext[oend - 1]) == 44) {
                oend = oend - 1;
            }
            // `*` and the first pair need no comma; the pairs carry their own.
            var start = 0;
            while start < oend && int_of(otext[start]) == 32 {
                start = start + 1;
            }
            line = buffer.append(heap, line, otext[start..oend]);
        }
    }
    if has_body {
        line = buffer.append(heap, line, ", body: ");
        line = body_type(heap, line, body);
    } else {
        model.drop_body(heap, body);
    }
    line = buffer.append(heap, line, ") -> ");
    // The 2xx return type, computed once (the walk consumes the responses).
    let ret_text = buffer.empty(heap, 64);
    let ret = return_type(heap, ret_text, responses);
    borrow ret as &rv in {
        line = buffer.append(heap, line, buffer.bytes(rv));
    }
    line = buffer.append(heap, line, ":\n");
    // The body: the query dict from the keyword arguments, then the call.
    line = buffer.append(heap, line, "        query: dict[str, Any] = {k: v for k, v in cast('list[tuple[str, Any]]', (");
    line = query_dict(heap, line, query_text);
    // query_dict consumed the query text.
    line = buffer.append(heap, line, ")) if v is not None}\n");
    line = buffer.append(heap, line, "        return cast('");
    borrow ret as &rc in {
        line = buffer.append(heap, line, buffer.bytes(rc));
    }
    line = buffer.append(heap, line, "', self.request('");
    line = buffer.append(heap, line, method_upper(method));
    line = buffer.append(heap, line, "', ");
    line = path_expression(heap, line, path);
    line = buffer.append(heap, line, ", query, ");
    if has_body {
        line = buffer.append(heap, line, "body))\n\n");
    } else {
        line = buffer.append(heap, line, "None))\n\n");
    }
    // The model's pieces are printed (the query text by query_dict); what
    // the pass kept, ends here.
    buffer.drop(heap, ret);
    buffer.drop(heap, opts_text);
    buffer.drop(heap, id);
    return line;
}

// The body's type (`T | None` when the body may be left out is the caller's
// business: the document's `required` already said; an absent argument is
// `None` by default and the server answers).
fn body_type[&h](heap: &!h Heap, out: buffer.Buffer, body: option.Option[model.Schema]) -> [heap] buffer.Buffer {
    match body {
        option.Option::None => {
            return out;
        }
        option.Option::Some(schema) => {
            return py_type(heap, out, schema);
        }
    }
}

// One consuming pass over the parameters: the required path arguments' text,
// the query names, and the query options' `name: T | None = None` pairs.
fn args_and_query[&h](heap: &!h Heap, ps: list.List[model.Parameter], args: buffer.Buffer, query: buffer.Buffer, opts: buffer.Buffer, count: int) -> [heap] (buffer.Buffer, buffer.Buffer, buffer.Buffer, int) {
    match ps {
        list.List::Empty => {
            return (args, query, opts, count);
        }
        list.List::Cons(one, rest) => {
            let tail = unbox(heap, rest);
            let model.Parameter { name, place, required, schema } = one;
            var in_path = false;
            var in_query = false;
            match place {
                model.Where::InPath => {
                    in_path = true;
                }
                model.Where::InQuery => {
                    in_query = true;
                }
                model.Where::InHeader => {
                }
            }
            var args2 = args;
            var query2 = query;
            var opts2 = opts;
            var n = count;
            if required && in_path {
                args2 = buffer.append(heap, args2, ", ");
                borrow name as &nb in {
                    args2 = buffer.append(heap, args2, buffer.bytes(nb));
                }
                args2 = buffer.append(heap, args2, ": ");
                args2 = py_type(heap, args2, schema);
                n = n + 1;
            } else if in_query && !required {
                borrow name as &nb in {
                    opts2 = buffer.append(heap, opts2, buffer.bytes(nb));
                    query2 = buffer.append(heap, query2, buffer.bytes(nb));
                }
                opts2 = buffer.append(heap, opts2, ": ");
                opts2 = py_type(heap, opts2, schema);
                opts2 = buffer.append(heap, opts2, " | None = None, ");
                query2 = buffer.append(heap, query2, ", ");
            } else {
                model.drop_schema(heap, schema);
            }
            buffer.drop(heap, name);
            return args_and_query(heap, tail, args2, query2, opts2, n);
        }
    }
}

// The query dict the method builds: `'limit': limit, 'offset': offset`.
// The values the caller left out are filtered before the request.
fn query_dict[&h](heap: &!h Heap, out: buffer.Buffer, query_text: buffer.Buffer) -> [heap] buffer.Buffer {
    var line = out;
    borrow query_text as &qb in {
        let qtext = buffer.bytes(qb);
        var i = 0;
        while i < len(qtext) {
            while i < len(qtext) && int_of(qtext[i]) == 32 {
                i = i + 1;
            }
            var end = i;
            while end < len(qtext) && int_of(qtext[end]) != 44 {
                end = end + 1;
            }
            if end > i {
                line = buffer.append(heap, line, "('");
                line = buffer.append(heap, line, qtext[i..end]);
                line = buffer.append(heap, line, "', ");
                line = buffer.append(heap, line, qtext[i..end]);
                line = buffer.append(heap, line, "), ");
            }
            i = end + 1;
        }
    }
    buffer.drop(heap, query_text);
    return line;
}

// The 2xx return type: the body's type, or `None` when the operation has no
// 2xx body (a 204 among them).
fn return_type[&h](heap: &!h Heap, out: buffer.Buffer, rs: list.List[model.Response]) -> [heap] buffer.Buffer {
    match rs {
        list.List::Empty => {
            return buffer.append(heap, out, "None");
        }
        list.List::Cons(one, rest) => {
            let tail = unbox(heap, rest);
            let model.Response { status, body } = one;
            match body {
                option.Option::None => {
                    return return_type(heap, out, tail);
                }
                option.Option::Some(schema) => {
                    if status >= 200 && status < 300 {
                        let line = py_type(heap, out, schema);
                        model.drop_responses(heap, tail);
                        return line;
                    }
                    model.drop_schema(heap, schema);
                    return return_type(heap, out, tail);
                }
            }
        }
    }
}

// `GET`, `POST`, ... -- the method as urllib wants it.
fn method_upper(m: model.Method) -> [] &static [byte] {
    match m {
        model.Method::Get => {
            return "GET";
        }
        model.Method::Put => {
            return "PUT";
        }
        model.Method::Post => {
            return "POST";
        }
        model.Method::Delete => {
            return "DELETE";
        }
        model.Method::Options => {
            return "OPTIONS";
        }
        model.Method::Head => {
            return "HEAD";
        }
        model.Method::Patch => {
            return "PATCH";
        }
        model.Method::Trace => {
            return "TRACE";
        }
    }
}

// The path: an f-string, `{id}` templates as interpolations.
fn path_expression[&h](heap: &!h Heap, out: buffer.Buffer, path: buffer.Buffer) -> [heap] buffer.Buffer {
    var line = buffer.append(heap, out, "f'");
    borrow path as &pb in {
        let text = buffer.bytes(pb);
        var i = 0;
        while i < len(text) {
            if int_of(text[i]) == 123 && i + 1 < len(text) {
                var end = i + 1;
                while end < len(text) && int_of(text[end]) != 125 {
                    end = end + 1;
                }
                line = buffer.append(heap, line, "{");
                line = buffer.append(heap, line, text[i + 1..end]);
                line = buffer.append(heap, line, "}");
                i = end + 1;
            } else {
                line = buffer.push(heap, line, text[i]);
                i = i + 1;
            }
        }
    }
    line = buffer.append(heap, line, "'");
    buffer.drop(heap, path);
    return line;
}

// ---------------------------------------------------------------------
// The runtime
// ---------------------------------------------------------------------

// The runtime: `request` builds and sends, decodes into the typed result or
// raises the typed error. No coercion: `problem+json` is `ProblemError`.
// `urllib.request` only -- the generated client needs no third package.
fn runtime[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var line = out;
    line = buffer.append(heap, line, "    def request(self, method: str, path: str, query: dict[str, Any], body: Any) -> Any:\n");
    line = buffer.append(heap, line, "        url = self.base_url + path\n        if query:\n            url += '?' + urllib.parse.urlencode(query)\n");
    line = buffer.append(heap, line, "        data = None\n        headers = {}\n        if body is not None:\n            data = json.dumps(body, default=_json_default).encode()\n            headers['Content-Type'] = 'application/json'\n");
    line = buffer.append(heap, line, "        req = urllib.request.Request(url, data=data, headers=headers, method=method)\n        try:\n            with urllib.request.urlopen(req) as resp:\n                raw = resp.read()\n");
    line = buffer.append(heap, line, "                ctype = resp.headers.get('Content-Type', '')\n                if ctype.startswith('application/problem+json'):\n                    raise ProblemError(_problem_from(json.loads(raw)))\n");
    line = buffer.append(heap, line, "                if not raw:\n                    return None\n                return json.loads(raw)\n");
    line = buffer.append(heap, line, "        except urllib.error.HTTPError as err:\n            raw = err.read()\n            try:\n                problem = json.loads(raw)\n            except Exception:\n                problem = {'type': 'about:blank', 'title': err.reason, 'status': err.code}\n");
    line = buffer.append(heap, line, "            raise ProblemError(_problem_from(problem)) from None\n\n");
    line = buffer.append(heap, line, "\ndef _json_default(o: Any) -> Any:\n    if is_dataclass(o):\n        return {f.name: v for f in o.__dataclass_fields__.values() if (v := getattr(o, f.name)) is not None}\n    raise TypeError(f'not serializable: {type(o).__name__}')\n\ndef _problem_from(raw: dict[str, Any]) -> Problem:\n    errors = None\n    if 'errors' in raw:\n        errors = list(raw['errors'])\n");
    line = buffer.append(heap, line, "    return Problem(\n        type=raw.get('type', 'about:blank'),\n        title=raw.get('title', ''),\n        status=raw.get('status', 0),\n        detail=raw.get('detail'),\n        count=raw.get('count'),\n        errors=errors,\n    )\n");
    return line;
}
