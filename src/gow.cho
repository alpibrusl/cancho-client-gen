edition 5;
module gow;

import std.buffer;
import std.bytes;
import std.list;
import std.option;

import model;

// The Go target (#7): the model, as one deterministic .go file.
//
// * a `type` per component -- a struct per named shape, the same discipline
//   as the TypeScript target;
// * a function per operation over `net/http`: path parameters as required
//   arguments, the body typed by its schema, the responses a typed struct;
// * `application/problem+json` a typed error implementing `error`
//   (`ProblemError`), carrying the Problem component's fields and the 422's
//   `errors` with `Pointer`/`Code`/`Detail`;
// * no coercion: the body is the struct the document declares, or the
//   response is a `*ProblemError`.
//
// The writer takes the model by value and consumes it as it prints, exactly
// as `ts.cho` does: same model, same gate, same bytes per document.

// The Go type for a schema. Consumes the schema it prints.
// Append `name` with its first byte upper-cased: Go exports struct fields,
// and the JSON tag keeps the document's spelling, so the contract survives.
fn append_exported[&h, &n](heap: &!h Heap, out: buffer.Buffer, name: &n [byte]) -> [heap] buffer.Buffer {
    var line = out;
    if len(name) > 0 {
        line = buffer.push(heap, line, byte_of(bytes.to_upper(int_of(name[0]))));
        line = buffer.append(heap, line, name[1..len(name)]);
    }
    return line;
}

fn go_type[&h](heap: &!h Heap, out: buffer.Buffer, s: model.Schema) -> [heap] buffer.Buffer {
    var line = out;
    match s {
        model.Schema::Ref(name) => {
            borrow name as &nb in {
                line = buffer.append(heap, line, buffer.bytes(nb));
            }
            buffer.drop(heap, name);
        }
        model.Schema::Boolean => {
            line = buffer.append(heap, line, "bool");
        }
        model.Schema::Integer => {
            line = buffer.append(heap, line, "int");
        }
        model.Schema::Number => {
            line = buffer.append(heap, line, "float64");
        }
        model.Schema::String => {
            line = buffer.append(heap, line, "string");
        }
        model.Schema::Array(inner) => {
            let items = unbox(heap, inner);
            line = buffer.append(heap, line, "[]");
            line = go_type(heap, line, items);
        }
        model.Schema::Object(held) => {
            // An inline object (until cancho-web#16 names these): the
            // structural type, as the model kept it.
            let fields = unbox(heap, held);
            line = buffer.append(heap, line, "struct { ");
            line = fields_type(heap, line, fields);
            line = buffer.append(heap, line, " }");
        }
    }
    return line;
}

// `Name Type` per field; the optionality of a JSON field is for the struct
// tags to say (Go has no optional field), so every field prints plainly.
fn fields_type[&h](heap: &!h Heap, out: buffer.Buffer, fields: list.List[model.Field]) -> [heap] buffer.Buffer {
    match fields {
        list.List::Empty => {
            return out;
        }
        list.List::Cons(one, rest) => {
            let model.Field { name, schema, required } = one;
            let tail = unbox(heap, rest);
            var line = out;
            borrow name as &nb in {
                line = buffer.append(heap, line, buffer.bytes(nb));
            }
            line = buffer.append(heap, line, " ");
            line = go_type(heap, line, schema);
            line = buffer.append(heap, line, "; ");
            buffer.drop(heap, name);
            return fields_type(heap, line, tail);
        }
    }
}

// The whole file. Consumes the model.
pub fn write[&h](heap: &!h Heap, doc: model.Doc) -> [heap] buffer.Buffer {
    let model.Doc { operations, components } = doc;
    var out = buffer.empty(heap, 8192);
    out = buffer.append(heap, out, "// Code generated by clientgen from the byte-verified OpenAPI 3.1 document. DO NOT EDIT.\n");
    out = buffer.append(heap, out, "// The gate (issue #6) diffs this file in CI.\n\n");
    out = buffer.append(heap, out, "package client\n\n");
    out = buffer.append(heap, out, "import (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/url\"\n\t\"strconv\"\n\t\"strings\"\n)\n\n");
    let (components, has_problem) = has_problem_component(heap, components);
    if !has_problem {
        out = problem_type(heap, out);
    } else {
        // The document names its own error schema `Problem`: the components
        // below include it, and only the error wrapper is the tool's.
        out = buffer.append(heap, out, "type ProblemError struct{ Problem Problem }\n\n");
        out = buffer.append(heap, out, "func (e *ProblemError) Error() string { return fmt.Sprintf(\"%s (%d)\", e.Problem.Title, e.Problem.Status) }\n\n");
    }
    out = components_block(heap, out, components);
    out = operations_block(heap, out, operations);
    out = runtime(heap, out);
    return out;
}

// `problem+json` as a typed error implementing `error`.
fn problem_type[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var line = out;
    line = buffer.append(heap, line, "// A typed error (RFC 9457): what the caller must handle, not a stringly catch.\n");
    line = buffer.append(heap, line, "type ProblemDetail struct {\n\tPointer string `json:\"pointer\"`\n\tCode    string `json:\"code\"`\n\tDetail  string `json:\"detail\"`\n}\n\n");
    line = buffer.append(heap, line, "type Problem struct {\n\tType   string          `json:\"type\"`\n\tTitle  string          `json:\"title\"`\n\tStatus int             `json:\"status\"`\n\tDetail string          `json:\"detail,omitempty\"`\n\tCount  int             `json:\"count,omitempty\"`\n\tErrors []ProblemDetail `json:\"errors,omitempty\"`\n}\n\n");
    line = buffer.append(heap, line, "type ProblemError struct{ Problem Problem }\n\n");
    line = buffer.append(heap, line, "func (e *ProblemError) Error() string { return fmt.Sprintf(\"%s (%d)\", e.Problem.Title, e.Problem.Status) }\n\n");
    return line;
}

// Does the document name a component `Problem`? (cancho-web's does; the
// generated client then uses it rather than emitting a second one.)
// Takes the list and hands it back: the reading is a pass, not an end.
fn has_problem_component[&h](heap: &!h Heap, comps: list.List[model.Component]) -> [heap] (list.List[model.Component], bool) {
    match comps {
        list.List::Empty => {
            return (list.List::Empty, false);
        }
        list.List::Cons(one, rest) => {
            let tail = unbox(heap, rest);
            let (kept, found_tail) = has_problem_component(heap, tail);
            let model.Component { name, schema } = one;
            var found = found_tail;
            borrow name as &nb in {
                if bytes.equal(buffer.bytes(nb), "Problem") {
                    found = true;
                }
            }
            let rebuilt = list.push(heap, kept, model.Component { name: name, schema: schema });
            return (rebuilt, found);
        }
    }
}

fn components_block[&h](heap: &!h Heap, out: buffer.Buffer, comps: list.List[model.Component]) -> [heap] buffer.Buffer {
    match comps {
        list.List::Empty => {
            return out;
        }
        list.List::Cons(one, rest) => {
            let model.Component { name, schema } = one;
            let tail = unbox(heap, rest);
            var line = buffer.append(heap, out, "type ");
            borrow name as &nb in {
                line = buffer.append(heap, line, buffer.bytes(nb));
            }
            line = buffer.append(heap, line, " struct {\n");
            line = struct_fields(heap, line, schema);
            line = buffer.append(heap, line, "}\n\n");
            buffer.drop(heap, name);
            return components_block(heap, line, tail);
        }
    }
}

// The fields of a component struct, one per line, with JSON tags.
fn struct_fields[&h](heap: &!h Heap, out: buffer.Buffer, s: model.Schema) -> [heap] buffer.Buffer {
    match s {
        model.Schema::Object(held) => {
            let fields = unbox(heap, held);
            return struct_fields_walk(heap, out, fields);
        }
        model.Schema::Ref(name) => {
            var line = buffer.append(heap, out, "= ");
            borrow name as &nb in {
                line = buffer.append(heap, line, buffer.bytes(nb));
            }
            buffer.drop(heap, name);
            line = buffer.append(heap, line, "\n");
            return line;
        }
        model.Schema::Boolean => {
            return buffer.append(heap, out, "= bool\n");
        }
        model.Schema::Integer => {
            return buffer.append(heap, out, "= int\n");
        }
        model.Schema::Number => {
            return buffer.append(heap, out, "= float64\n");
        }
        model.Schema::String => {
            return buffer.append(heap, out, "= string\n");
        }
        model.Schema::Array(inner) => {
            let items = unbox(heap, inner);
            var line = buffer.append(heap, out, "= []");
            line = go_type(heap, line, items);
            line = buffer.append(heap, line, "\n");
            return line;
        }
    }
}

fn struct_fields_walk[&h](heap: &!h Heap, out: buffer.Buffer, fields: list.List[model.Field]) -> [heap] buffer.Buffer {
    match fields {
        list.List::Empty => {
            return out;
        }
        list.List::Cons(one, rest) => {
            let model.Field { name, schema, required } = one;
            let tail = unbox(heap, rest);
            var line = buffer.append(heap, out, "\t");
            borrow name as &nb in {
                line = append_exported(heap, line, buffer.bytes(nb));
            }
            line = buffer.append(heap, line, " ");
            line = go_type(heap, line, schema);
            // The tag: the document's spelling, and `omitempty` exactly when
            // the document does not require the field (strictness at the
            // marshal boundary is the tag's to enforce).
            line = buffer.append(heap, line, " `json:\"");
            borrow name as &nb2 in {
                line = buffer.append(heap, line, buffer.bytes(nb2));
            }
            if !required {
                line = buffer.append(heap, line, ",omitempty");
            }
            line = buffer.append(heap, line, "\"`\n");
            buffer.drop(heap, name);
            return struct_fields_walk(heap, line, tail);
        }
    }
}

fn operations_block[&h](heap: &!h Heap, out: buffer.Buffer, ops: list.List[model.Operation]) -> [heap] buffer.Buffer {
    match ops {
        list.List::Empty => {
            return out;
        }
        list.List::Cons(one, rest) => {
            let tail = unbox(heap, rest);
            var line = operation_block(heap, out, one);
            return operations_block(heap, line, tail);
        }
    }
}

// One operation: a typed function over the runtime's `request`. Required
// path parameters are required arguments; the body is typed; the return is
// the 2xx body (or `struct{}{}` when the operation has no 2xx body).
fn operation_block[&h](heap: &!h Heap, out: buffer.Buffer, op: model.Operation) -> [heap] buffer.Buffer {
    let model.Operation { id, method, path, parameters, body, body_optional, responses } = op;
    var line = buffer.append(heap, out, "func ");
    borrow id as &ib in {
        line = buffer.append(heap, line, buffer.bytes(ib));
    }
    line = buffer.append(heap, line, "(c *Client");
    // Parameters and body, in one consuming pass.
    let args = buffer.empty(heap, 128);
    let qnames = buffer.empty(heap, 64);
    let opttypes = buffer.empty(heap, 64);
    let (args_text, query_text, opts_text, required_count) = args_and_query(heap, parameters, args, qnames, opttypes, 0);
    borrow args_text as &ab in {
        let text = buffer.bytes(ab);
        var end = len(text);
        while end > 0 && (int_of(text[end - 1]) == 32 || int_of(text[end - 1]) == 44) {
            end = end - 1;
        }
        line = buffer.append(heap, line, text[0..end]);
    }
    buffer.drop(heap, args_text);
    var has_body = false;
    borrow body as &bd in {
        if option.is_some(bd) {
            has_body = true;
            line = buffer.append(heap, line, ", body ");
        }
    }
    line = body_type(heap, line, body);
    // The optional query parameters, as a variadic-free options struct.
    borrow opts_text as &ob in {
        let otext = buffer.bytes(ob);
        var oend = len(otext);
        while oend > 0 && (int_of(otext[oend - 1]) == 32 || int_of(otext[oend - 1]) == 44) {
            oend = oend - 1;
        }
        if oend > 0 {
            line = buffer.append(heap, line, ", ");
            line = buffer.append(heap, line, "options *");
            borrow id as &ib2 in {
                line = buffer.append(heap, line, buffer.bytes(ib2));
            }
            line = buffer.append(heap, line, "Options");
        }
    }
    line = buffer.append(heap, line, ") (");
    // The 2xx return type, computed once (the walk consumes the responses).
    let ret_text = buffer.empty(heap, 64);
    let ret = return_type(heap, ret_text, responses);
    borrow ret as &rv in {
        line = buffer.append(heap, line, buffer.bytes(rv));
    }
    line = buffer.append(heap, line, ", error) {\n");
    line = buffer.append(heap, line, "\tresp, err := c.do(\"");
    line = buffer.append(heap, line, method_upper(method));
    line = buffer.append(heap, line, "\", ");
    line = path_expression(heap, line, path);
    line = buffer.append(heap, line, ", ");
    line = query_expression(heap, line, query_text);
    if has_body {
        line = buffer.append(heap, line, ", body");
    } else {
        line = buffer.append(heap, line, ", nil");
    }
    line = buffer.append(heap, line, ")\n");
    line = buffer.append(heap, line, "\tif err != nil {\n\t\tvar zero ");
    borrow ret as &rv0 in {
        line = buffer.append(heap, line, buffer.bytes(rv0));
    }
    line = buffer.append(heap, line, "\n\t\treturn zero, err\n\t}\n");
    line = buffer.append(heap, line, "\treturn decode[");
    borrow ret as &rv2 in {
        line = buffer.append(heap, line, buffer.bytes(rv2));
    }
    line = buffer.append(heap, line, "](resp)\n}\n\n");
    buffer.drop(heap, ret);
    // The options struct, when there were optional query parameters.
    line = options_struct(heap, line, opts_text, id);
    return line;
}

// The body's type (`*T` -- a pointer, so a required body is distinguishable
// from an absent one at the call site).
fn body_type[&h](heap: &!h Heap, out: buffer.Buffer, body: option.Option[model.Schema]) -> [heap] buffer.Buffer {
    match body {
        option.Option::None => {
            return out;
        }
        option.Option::Some(schema) => {
            var line = buffer.append(heap, out, "*");
            line = go_type(heap, line, schema);
            return line;
        }
    }
}

// One consuming pass over the parameters: the required path arguments' text,
// the query names, the options struct's fields.
fn args_and_query[&h](heap: &!h Heap, ps: list.List[model.Parameter], args: buffer.Buffer, query: buffer.Buffer, opts: buffer.Buffer, count: int) -> [heap] (buffer.Buffer, buffer.Buffer, buffer.Buffer, int) {
    match ps {
        list.List::Empty => {
            return (args, query, opts, count);
        }
        list.List::Cons(one, rest) => {
            let tail = unbox(heap, rest);
            let model.Parameter { name, place, required, schema } = one;
            var in_path = false;
            var in_query = false;
            match place {
                model.Where::InPath => {
                    in_path = true;
                }
                model.Where::InQuery => {
                    in_query = true;
                }
                model.Where::InHeader => {
                }
            }
            var args2 = args;
            var query2 = query;
            var opts2 = opts;
            var n = count;
            if required && in_path {
                args2 = buffer.append(heap, args2, ", ");
                borrow name as &nb in {
                    args2 = buffer.append(heap, args2, buffer.bytes(nb));
                }
                args2 = buffer.append(heap, args2, " ");
                args2 = go_type(heap, args2, schema);
                n = n + 1;
            } else if in_query && !required {
                borrow name as &nb in {
                    opts2 = buffer.append(heap, opts2, buffer.bytes(nb));
                    query2 = buffer.append(heap, query2, buffer.bytes(nb));
                }
                opts2 = buffer.append(heap, opts2, " ");
                opts2 = go_type(heap, opts2, schema);
                opts2 = buffer.append(heap, opts2, ", ");
                query2 = buffer.append(heap, query2, ", ");
            } else {
                model.drop_schema(heap, schema);
            }
            buffer.drop(heap, name);
            return args_and_query(heap, tail, args2, query2, opts2, n);
        }
    }
}

// The 2xx return type: the body's type, or the empty struct.
fn return_type[&h](heap: &!h Heap, out: buffer.Buffer, rs: list.List[model.Response]) -> [heap] buffer.Buffer {
    match rs {
        list.List::Empty => {
            return buffer.append(heap, out, "struct{}");
        }
        list.List::Cons(one, rest) => {
            let tail = unbox(heap, rest);
            let model.Response { status, body } = one;
            match body {
                option.Option::None => {
                    return return_type(heap, out, tail);
                }
                option.Option::Some(schema) => {
                    if status >= 200 && status < 300 {
                        let line = go_type(heap, out, schema);
                        model.drop_responses(heap, tail);
                        return line;
                    }
                    model.drop_schema(heap, schema);
                    return return_type(heap, out, tail);
                }
            }
        }
    }
}

// `GET`, `POST`, ... -- the method as net/http wants it.
fn method_upper(m: model.Method) -> [] &static [byte] {
    match m {
        model.Method::Get => {
            return "GET";
        }
        model.Method::Put => {
            return "PUT";
        }
        model.Method::Post => {
            return "POST";
        }
        model.Method::Delete => {
            return "DELETE";
        }
        model.Method::Options => {
            return "OPTIONS";
        }
        model.Method::Head => {
            return "HEAD";
        }
        model.Method::Patch => {
            return "PATCH";
        }
        model.Method::Trace => {
            return "TRACE";
        }
    }
}

// The path, `{id}` templates becoming `fmt.Sprintf` arguments: the path
// literal first, then the values.
fn path_expression[&h](heap: &!h Heap, out: buffer.Buffer, path: buffer.Buffer) -> [heap] buffer.Buffer {
    var line = buffer.append(heap, out, "c.fmtPath(`");
    var args = buffer.empty(heap, 128);
    borrow path as &pb in {
        let text = buffer.bytes(pb);
        var i = 0;
        while i < len(text) {
            if int_of(text[i]) == 123 && i + 1 < len(text) {
                var end = i + 1;
                while end < len(text) && int_of(text[end]) != 125 {
                    end = end + 1;
                }
                line = buffer.append(heap, line, "%s");
                args = buffer.append(heap, args, text[i + 1..end]);
                args = buffer.append(heap, args, ", ");
                i = end + 1;
            } else {
                line = buffer.push(heap, line, text[i]);
                i = i + 1;
            }
        }
    }
    var had_args = false;
    borrow args as &ar in {
        let atext = buffer.bytes(ar);
        var aend = len(atext);
        while aend > 0 && (int_of(atext[aend - 1]) == 32 || int_of(atext[aend - 1]) == 44) {
            aend = aend - 1;
        }
        if aend > 0 {
            had_args = true;
            line = buffer.append(heap, line, "`, ");
            line = buffer.append(heap, line, atext[0..aend]);
        }
    }
    if !had_args {
        line = buffer.append(heap, line, "`");
    }
    line = buffer.append(heap, line, ")");
    buffer.drop(heap, args);
    buffer.drop(heap, path);
    return line;
}

// The query: the runtime builds it from the options struct, or nil.
fn query_expression[&h](heap: &!h Heap, out: buffer.Buffer, query_text: buffer.Buffer) -> [heap] buffer.Buffer {
    var line = out;
    borrow query_text as &qb in {
        let qtext = buffer.bytes(qb);
        var qend = len(qtext);
        while qend > 0 && (int_of(qtext[qend - 1]) == 32 || int_of(qtext[qend - 1]) == 44) {
            qend = qend - 1;
        }
        if qend == 0 {
            line = buffer.append(heap, line, "nil");
        } else {
            line = buffer.append(heap, line, "options");
        }
    }
    buffer.drop(heap, query_text);
    return line;
}

// The options struct for an operation's optional query parameters.

// `if o.Name != zero { v.Set(...) }` per options field. The type says the
// formatting: int via strconv, string as-is.
fn query_setters[&h, &t](heap: &!h Heap, out: buffer.Buffer, text: &t [byte]) -> [heap] buffer.Buffer {
    var line = out;
    var i = 0;
    while i < len(text) {
        while i < len(text) && int_of(text[i]) == 32 {
            i = i + 1;
        }
        var end = i;
        while end < len(text) && int_of(text[end]) != 44 {
            end = end + 1;
        }
        let pair = text[i..end];
        var sp = 0;
        while sp < len(pair) && int_of(pair[sp]) != 32 {
            sp = sp + 1;
        }
        let name = pair[0..sp];
        line = buffer.append(heap, line, "\tif o.");
        line = append_exported(heap, line, name);
        line = buffer.append(heap, line, " != 0 { v.Set(\"");
        line = buffer.append(heap, line, name);
        line = buffer.append(heap, line, "\", strconv.Itoa(o.");
        line = append_exported(heap, line, name);
        line = buffer.append(heap, line, ")) }\n");
        i = end + 1;
    }
    return line;
}

fn options_struct[&h](heap: &!h Heap, out: buffer.Buffer, opts_text: buffer.Buffer, id: buffer.Buffer) -> [heap] buffer.Buffer {
    var line = out;
    var any = false;
    borrow opts_text as &ob in {
        let otext = buffer.bytes(ob);
        var oend = len(otext);
        while oend > 0 && (int_of(otext[oend - 1]) == 32 || int_of(otext[oend - 1]) == 44) {
            oend = oend - 1;
        }
        if oend > 0 {
            any = true;
            line = buffer.append(heap, line, "type ");
            borrow id as &ib in {
                line = buffer.append(heap, line, buffer.bytes(ib));
            }
            line = buffer.append(heap, line, "Options struct {\n");
            line = options_fields(heap, line, otext[0..oend]);
            line = buffer.append(heap, line, "}\n\n");
            // The querier: each set field becomes a query parameter.
            line = buffer.append(heap, line, "func (o *");
            borrow id as &ib2 in {
                line = buffer.append(heap, line, buffer.bytes(ib2));
            }
            line = buffer.append(heap, line, "Options) query() url.Values {\n\tv := url.Values{}\n");
            line = query_setters(heap, line, otext[0..oend]);
            line = buffer.append(heap, line, "\treturn v\n}\n\n");
        }
    }
    buffer.drop(heap, opts_text);
    buffer.drop(heap, id);
    if !any {
        return line;
    }
    return line;
}

fn options_fields[&h, &t](heap: &!h Heap, out: buffer.Buffer, text: &t [byte]) -> [heap] buffer.Buffer {
    var line = out;
    var i = 0;
    while i < len(text) {
        // A field: name, space, type, comma (and a space after the comma).
        while i < len(text) && int_of(text[i]) == 32 {
            i = i + 1;
        }
        var end = i;
        while end < len(text) && int_of(text[end]) != 44 {
            end = end + 1;
        }
        let pair = text[i..end];
        // Split on the first space.
        var sp = 0;
        while sp < len(pair) && int_of(pair[sp]) != 32 {
            sp = sp + 1;
        }
        line = buffer.append(heap, line, "\t");
        line = append_exported(heap, line, pair[0..sp]);
        line = buffer.append(heap, line, " ");
        line = buffer.append(heap, line, pair[sp + 1..len(pair)]);
        line = buffer.append(heap, line, "\n");
        i = end + 1;
    }
    return line;
}

// The runtime: a Client with the base URL, `do` building and sending the
// request, `decode` turning the response into the typed result or the
// typed error. No coercion: `problem+json` is `*ProblemError`.
fn runtime[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var line = out;
    line = buffer.append(heap, line, "type Client struct {\n\tBaseURL string\n\tHTTP    *http.Client\n}\n\n");
    line = buffer.append(heap, line, "func NewClient(baseURL string) *Client { return &Client{BaseURL: baseURL, HTTP: http.DefaultClient} }\n\n");
    line = buffer.append(heap, line, "func (c *Client) fmtPath(format string, args ...int) string {\n");
    line = buffer.append(heap, line, "\tstrs := make([]any, len(args))\n\tfor i, a := range args { strs[i] = strconv.Itoa(a) }\n\treturn fmt.Sprintf(format, strs...)\n}\n\n");
    line = buffer.append(heap, line, "type querier interface{ query() url.Values }\n\n");
    line = buffer.append(heap, line, "func (c *Client) do(method, path string, options querier, body any) (*http.Response, error) {\n");
    line = buffer.append(heap, line, "\tu, err := url.Parse(c.BaseURL + path)\n\tif err != nil { return nil, err }\n");
    line = buffer.append(heap, line, "\tif options != nil { u.RawQuery = options.query().Encode() }\n");
    line = buffer.append(heap, line, "\tvar rd io.Reader\n\tif body != nil {\n\t\tb, err := json.Marshal(body)\n\t\tif err != nil { return nil, err }\n\t\trd = bytes.NewReader(b)\n\t}\n");
    line = buffer.append(heap, line, "\treq, err := http.NewRequest(method, u.String(), rd)\n\tif err != nil { return nil, err }\n");
    line = buffer.append(heap, line, "\tif body != nil { req.Header.Set(\"Content-Type\", \"application/json\") }\n");
    line = buffer.append(heap, line, "\treturn c.HTTP.Do(req)\n}\n\n");
    line = buffer.append(heap, line, "func decode[T any](resp *http.Response) (T, error) {\n");
    line = buffer.append(heap, line, "\tdefer resp.Body.Close()\n");
    line = buffer.append(heap, line, "\tbody, err := io.ReadAll(resp.Body)\n\tif err != nil { var zero T; return zero, err }\n");
    line = buffer.append(heap, line, "\tif ct := resp.Header.Get(\"Content-Type\"); strings.HasPrefix(ct, \"application/problem+json\") {\n");
    line = buffer.append(heap, line, "\t\tvar p Problem\n\t\tif err := json.Unmarshal(body, &p); err != nil { var zero T; return zero, err }\n");
    line = buffer.append(heap, line, "\t\tvar zero T\n\t\treturn zero, &ProblemError{Problem: p}\n\t}\n");
    line = buffer.append(heap, line, "\tif resp.StatusCode >= 400 {\n");
    line = buffer.append(heap, line, "\t\tvar zero T\n\t\treturn zero, &ProblemError{Problem: Problem{Type: \"about:blank\", Title: http.StatusText(resp.StatusCode), Status: resp.StatusCode}}\n\t}\n");
    line = buffer.append(heap, line, "\tvar result T\n\tif len(body) == 0 { return result, nil }\n");
    line = buffer.append(heap, line, "\tif err := json.Unmarshal(body, &result); err != nil { var zero T; return zero, err }\n");
    line = buffer.append(heap, line, "\treturn result, nil\n}\n");
    return line;
}
