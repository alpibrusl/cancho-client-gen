edition 5;

import std.buffer;
import std.bytes;
import std.io;
import std.json;
import std.list;
import std.option;

import model;

// `clientgen` -- strictly typed clients from the byte-verified OpenAPI document.
//
//     clientgen <openapi.json> [--check | --model]
//
// The file is parsed with `std.json`'s reader (a tape over the file's own
// bytes, no copy, no foreign code). The reader's shape walk (#3) refuses what
// is not an OpenAPI 3.1 document; the model (#4) reads the operations and the
// components out of it, `$ref` resolved to a name. Nothing is written for an
// invalid document -- pgen's discipline: a query the server refuses never
// reaches a build, and a document that does not model never reaches a client.
//
// `--check` answers 0/1 for "is this the document a client can come from" and
// prints what it found (the gate slice builds on it: CI regenerates and diffs).
// `--model` builds the model and prints it: one line per operation, one per
// component -- the shape a writer writes from, checked by building it.
//
// `cancho authority` on it reports `args`, `heap`, `fs_read("")`, the console --
// and no `ffi`.

// The most a document may be: 8 MiB, like a body the users example will take.
fn most_bytes() -> [] int {
    return 8388608;
}

fn complain[&i, &n, &w](io: &!i Io, name: &n [byte], what: &w [byte]) -> [err_write] int {
    io.error_all(io, "clientgen: ");
    io.error_all(io, name);
    io.error_all(io, ": ");
    io.error_all(io, what);
    io.error_all(io, "\n");
    return 1;
}

// ---------------------------------------------------------------------
// The reader's shape walk (#3), in the model's words
// ---------------------------------------------------------------------

// `"3.1.0"`, `"3.1.1"`, ...: five bytes, `3`, `.`, `1`, `.`, then digits.
fn version_31[&s, &t](src: &s [byte], tape: &t [int], i: int) -> [] bool {
    if !json.string_plain(tape, i) {
        return false;
    }
    let text = json.string_view(src, tape, i);
    if len(text) < 5 {
        return false;
    }
    if int_of(text[0]) != 51 || int_of(text[1]) != 46 || int_of(text[2]) != 49 || int_of(text[3]) != 46 {
        return false;
    }
    var p = 4;
    while p < len(text) {
        if !bytes.is_digit(int_of(text[p])) {
            return false;
        }
        p = p + 1;
    }
    return true;
}

// The nine checks of the shape walk, as the model's `Refusal` (see model.cho).
pub fn check_shape[&s, &t](src: &s [byte], tape: &t [int]) -> [] option.Option[model.Refusal] {
    if !json.is_object(tape, 0) {
        return option.Option::Some(model.Refusal::RootNotObject);
    }
    let version = json.get(src, tape, 0, "openapi");
    if version < 0 || !json.is_string(tape, version) {
        return option.Option::Some(model.Refusal::OpenApiMissing);
    }
    if !version_31(src, tape, version) {
        return option.Option::Some(model.Refusal::OpenApiNot31);
    }
    let info = json.get(src, tape, 0, "info");
    if info < 0 || !json.is_object(tape, info) {
        return option.Option::Some(model.Refusal::InfoMissing);
    }
    let title = json.get(src, tape, info, "title");
    if title < 0 || !json.is_string(tape, title) {
        return option.Option::Some(model.Refusal::InfoTitleMissing);
    }
    let ver = json.get(src, tape, info, "version");
    if ver < 0 || !json.is_string(tape, ver) {
        return option.Option::Some(model.Refusal::InfoVersionMissing);
    }
    let paths = json.get(src, tape, 0, "paths");
    if paths < 0 || !json.is_object(tape, paths) {
        return option.Option::Some(model.Refusal::PathsMissing);
    }
    let comps = json.get(src, tape, 0, "components");
    if comps >= 0 && !json.is_object(tape, comps) {
        return option.Option::Some(model.Refusal::ComponentsNotObject);
    }
    // A path item that is not an object is a document that cannot be walked.
    var j = paths + 1;
    var left = json.count(tape, paths);
    while left > 0 {
        if !json.is_object(tape, j + 1) {
            return option.Option::Some(model.Refusal::PathItemNotObject);
        }
        j = json.skip(tape, j + 1);
        left = left - 1;
    }
    return option.Option::None;
}

// ---------------------------------------------------------------------
// Printing the model (#4)
// ---------------------------------------------------------------------

// One word for a schema, in a printed line: the name of a resolved `$ref`,
// or the kind. A nested `array` prints its item kind in brackets.
fn schema_word[&h, &s](heap: &!h Heap, out: buffer.Buffer, s: &s model.Schema) -> [heap] buffer.Buffer {
    var line = out;
    match s {
        model.Schema::Ref(name) => {
            line = buffer.append(heap, line, buffer.bytes(name));
        }
        model.Schema::Boolean => {
            line = buffer.append(heap, line, "boolean");
        }
        model.Schema::Integer => {
            line = buffer.append(heap, line, "integer");
        }
        model.Schema::Number => {
            line = buffer.append(heap, line, "number");
        }
        model.Schema::String => {
            line = buffer.append(heap, line, "string");
        }
        model.Schema::Object => {
            line = buffer.append(heap, line, "object");
        }
        model.Schema::Array(inner) => {
            line = buffer.append(heap, line, "array[");
            let items = contents(inner);
            line = schema_word(heap, line, items);
            line = buffer.append(heap, line, "]");
        }
    }
    return line;
}

// Each response's status and body schema, in one printed line.
fn response_words[&h](heap: &!h Heap, out: buffer.Buffer, rs: list.List[model.Response]) -> [heap] buffer.Buffer {
    var line = out;
    match rs {
        list.List::Empty => {
            return line;
        }
        list.List::Cons(one, rest) => {
            let tail = unbox(heap, rest);
            let model.Response { status, body } = one;
            line = buffer.push_nat(heap, line, status);
            line = buffer.append(heap, line, "=");
            match body {
                option.Option::None => {
                    line = buffer.append(heap, line, "none");
                }
                option.Option::Some(schema) => {
                    borrow schema as &sb in {
                        line = schema_word(heap, line, sb);
                    }
                    model.drop_schema(heap, schema);
                }
            }
            line = buffer.append(heap, line, " ");
            return response_words(heap, line, tail);
        }
    }
}

// The model, as lines: one per operation (method, path, id, parameter count,
// body, response count), one per component. The walk consumes the model, which
// is fine: `--model` prints and ends it. (`schema_word` borrows the schema it
// prints, so an operation's body prints without being taken apart first.)
fn print_model[&h, &i](heap: &!h Heap, io: &!i Io, doc: model.Doc) -> [heap, io_write] int {
    let model.Doc { operations, components } = doc;
    print_operations(heap, io, operations);
    print_components(heap, io, components);
    return 0;
}

fn print_operations[&h, &i](heap: &!h Heap, io: &!i Io, ops: list.List[model.Operation]) -> [heap, io_write] int {
    match ops {
        list.List::Empty => {
            return 0;
        }
        list.List::Cons(one, rest) => {
            let tail = unbox(heap, rest);
            let model.Operation { id, method, path, parameters, body, body_optional, responses } = one;
            borrow id as &ib in {
                borrow path as &pb in {
                    var line = buffer.append(heap, buffer.empty(heap, 96), model.method_name(method));
                    line = buffer.append(heap, line, " ");
                    line = buffer.append(heap, line, buffer.bytes(pb));
                    line = buffer.append(heap, line, " -> ");
                    line = buffer.append(heap, line, buffer.bytes(ib));
                    line = buffer.append(heap, line, " (");
                    borrow parameters as &ps in {
                        line = buffer.push_nat(heap, line, list.length(ps));
                    }
                    line = buffer.append(heap, line, " parameters, body ");
                    match body {
                        option.Option::None => {
                            line = buffer.append(heap, line, "none");
                        }
                        option.Option::Some(schema) => {
                            borrow schema as &sb in {
                                line = schema_word(heap, line, sb);
                            }
                            model.drop_schema(heap, schema);
                        }
                    }
                    line = buffer.append(heap, line, ", ");
                    borrow responses as &rs in {
                        line = buffer.push_nat(heap, line, list.length(rs));
                    }
                    line = buffer.append(heap, line, " responses: ");
                    line = response_words(heap, line, responses);
                    line = buffer.append(heap, line, ")\n");
                    borrow line as &lb in {
                        io.write_all(io, buffer.bytes(lb));
                    }
                    buffer.drop(heap, line);
                }
            }
            buffer.drop(heap, id);
            buffer.drop(heap, path);
            model.drop_parameters(heap, parameters);
            return print_operations(heap, io, tail);
        }
    }
}

fn print_components[&h, &i](heap: &!h Heap, io: &!i Io, comps: list.List[model.Component]) -> [heap, io_write] int {
    match comps {
        list.List::Empty => {
            return 0;
        }
        list.List::Cons(one, rest) => {
            let tail = unbox(heap, rest);
            let model.Component { name, schema } = one;
            borrow name as &nb in {
                var line = buffer.append(heap, buffer.empty(heap, 64), "component ");
                line = buffer.append(heap, line, buffer.bytes(nb));
                line = buffer.append(heap, line, ": ");
                borrow schema as &sb in {
                    line = schema_word(heap, line, sb);
                }
                line = buffer.append(heap, line, "\n");
                borrow line as &lb in {
                    io.write_all(io, buffer.bytes(lb));
                }
                buffer.drop(heap, line);
            }
            buffer.drop(heap, name);
            model.drop_schema(heap, schema);
            return print_components(heap, io, tail);
        }
    }
}

// ---------------------------------------------------------------------
// The tool
// ---------------------------------------------------------------------

// `clientgen <openapi.json> [--check | --model]` -- read the document, build
// its model, or refuse it.
fn run[&h, &g, &i, &z](heap: &!h Heap, args: &g Args, io: &!i Io, fs: &z Fs("")) -> [heap, args, io_write, err_write, fs_read("")] int {
    let path = arg(args, 1);
    var checking = false;
    var modelling = false;
    if arg_count(args) > 2 {
        if bytes.equal(arg(args, 2), "--check") {
            checking = true;
        } else if bytes.equal(arg(args, 2), "--model") {
            modelling = true;
        }
    }
    let source = box_slice(heap, most_bytes() + 1, byte_of(0));
    var got = 0 - 1;
    if bytes.find(path, "..") < 0 {
        borrow mut source as &!sw in {
            got = fs_read(fs, path, contents(sw));
        }
    }
    var status = 1;
    if bytes.find(path, "..") >= 0 {
        complain(io, path, "a path with `..` in it is refused (the file capability traps on it); give the path without");
    } else if got < 0 {
        complain(io, path, "cannot read that file");
    } else if got > most_bytes() {
        complain(io, path, "the document is over 8 MiB");
    } else {
        borrow source as &sr in {
            let text = contents(sr)[0..got];
            let tape = box_slice(heap, json.tape_len(text), 0);
            borrow mut tape as &!tw in {
                let tp = contents(tw);
                let nodes = json.parse(text, tp);
                if nodes < 0 {
                    var detail = buffer.append(heap, buffer.empty(heap, 64), "not valid JSON: ");
                    detail = buffer.append(heap, detail, json.error_message(json.error_code(nodes)));
                    detail = buffer.append(heap, detail, " at byte ");
                    detail = buffer.push_nat(heap, detail, json.error_position(nodes));
                    borrow detail as &db in {
                        complain(io, path, buffer.bytes(db));
                    }
                    buffer.drop(heap, detail);
                } else {
                    let shape_bad = check_shape(text, tp);
                    match shape_bad {
                        option.Option::Some(refused) => {
                            complain(io, path, model.refusal_name(refused));
                        }
                        option.Option::None => {
                            // The document's shape is a document; build the model.
                            let (doc, model_bad) = model.build(heap, text, tp);
                            if model_bad != 0 {
                                model.drop_doc(heap, doc);
                                complain(io, path, model.refusal_name(model.refusal_of(model_bad)));
                            } else if checking {
                                // The gate's answer: a document a client can come from.
                                let model.Doc { operations, components } = doc;
                                var line = buffer.append(heap, buffer.empty(heap, 64), "ok ");
                                borrow operations as &ol in {
                                    line = buffer.push_nat(heap, line, list.length(ol));
                                }
                                line = buffer.append(heap, line, " operations, ");
                                borrow components as &cl in {
                                    line = buffer.push_nat(heap, line, list.length(cl));
                                }
                                line = buffer.append(heap, line, " components\n");
                                borrow line as &lb in {
                                    io.write_all(io, buffer.bytes(lb));
                                }
                                buffer.drop(heap, line);
                                model.drop_operations(heap, operations);
                                model.drop_components(heap, components);
                                status = 0;
                            } else if modelling {
                                print_model(heap, io, doc);
                                status = 0;
                            } else {
                                model.drop_doc(heap, doc);
                                // The writers are slices 4-6 (#5, #7, #8).
                                complain(io, path, "the model is built, the writers are not: --check or --model answers what this document says (issues #5, #7, #8)");
                            }
                        }
                    }
                }
            }
            unbox_slice(heap, tape);
        }
    }
    unbox_slice(heap, source);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(ffi);
    release(net);
    release(clock);
    var status = 1;
    borrow mut io as &!ie in {
        borrow fs as &z in {
            borrow args as &g in {
                if arg_count(g) < 2 || arg_count(g) > 3 {
                    io.error_all(ie, "usage: clientgen <openapi.json> [--check | --model]\n");
                    status = 2;
                } else {
                    borrow mut heap as &!h in {
                        status = run(h, g, ie, z);
                    }
                }
            }
        }
    }
    release(fs);
    release(args);
    release(io);
    release(heap);
    return status;
}
